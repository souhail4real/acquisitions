# ===========================================
# Production Environment Configuration
# ===========================================
# This file is a TEMPLATE for production deployment
# DO NOT commit actual secrets to version control!
# Use environment variables or a secrets manager in production

# Server Configuration
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# ===========================================
# JWT Configuration (REQUIRED)
# ===========================================
# Generate a strong secret: openssl rand -base64 64
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_SECRET_IN_PRODUCTION

# ===========================================
# Neon Cloud Database URL (REQUIRED)
# ===========================================
# Get this from: Neon Console → Your Project → Connection Details
# Format: postgresql://user:password@endpoint-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@YOUR_ENDPOINT.neon.tech/neondb?sslmode=require

# ===========================================
# Production Settings
# ===========================================
# Explicitly disable Neon Local in production
USE_NEON_LOCAL=false

# ===========================================
# IMPORTANT SECURITY NOTES:
# ===========================================
# 1. Never commit this file with real secrets to Git
# 2. Use environment variables or secrets manager (AWS Secrets, Vault, etc.)
# 3. Rotate JWT_SECRET periodically
# 4. Use connection pooling for database (Neon provides pooler endpoint)
# 5. Enable SSL/TLS for all connections
