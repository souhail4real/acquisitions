# ===========================================
# Development Environment Configuration
# ===========================================
# This file is used for local development with Neon Local
# Copy this to .env.development and fill in your values

# Server Configuration
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-12345!@#

# ===========================================
# Neon Local Configuration (Required for Docker)
# ===========================================
# Get your API key from: https://console.neon.tech/app/settings/api-keys
NEON_API_KEY=napi_g9ov5p45pnfemjsgxl4xlhdsczd29rce3m06ajguulitgmhihv07450820k35phc

# Get your Project ID from: Neon Console → Project Settings → General
NEON_PROJECT_ID=org-sparkling-rain-52107753

# Optional: Parent branch ID for ephemeral branches
# If not set, uses your project's default branch
PARENT_BRANCH_ID=br-winter-shadow-agyh83cn

# Database name (default: neondb)
DB_NAME=neondb

# Set to 'false' to persist branches after container stops
DELETE_BRANCH=true

# ===========================================
# Database URL (Auto-configured by Docker)
# ===========================================
# When using docker-compose.dev.yml, this is automatically set to:
# postgres://neon:npg@neon-local:5432/neondb?sslmode=require
#
# For local development WITHOUT Docker, use your Neon Cloud URL:
DATABASE_URL=postgresql://neondb_owner:npg_vRfmqAdQ9V8i@ep-lingering-art-agg5huhz-pooler.c-2.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ===========================================
# Neon Local Driver Settings (Temporarily Disabled)
# ===========================================
USE_NEON_LOCAL=false
NEON_LOCAL_HOST=neon-local
NEON_LOCAL_PORT=5432
