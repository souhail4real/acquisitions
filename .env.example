# ===========================================
# Environment Configuration Template
# ===========================================
# Copy this file to .env, .env.development, or .env.production
# and fill in the appropriate values

# ===========================================
# Server Configuration
# ===========================================
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ===========================================
# Database Configuration (REQUIRED)
# ===========================================
# For Neon Cloud (Production/Staging):
# Get this from: Neon Console → Your Project → Connection Details
# Format: postgresql://user:password@endpoint-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@your-endpoint.neon.tech/neondb?sslmode=require

# ===========================================
# JWT Configuration (REQUIRED)
# ===========================================
# Generate a strong secret: openssl rand -base64 64
# NEVER use the default value in production!
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# ===========================================
# Neon Local Configuration (Development Only)
# ===========================================
# Set to 'true' to use Neon Local proxy for development
USE_NEON_LOCAL=false

# Get your API key from: https://console.neon.tech/app/settings/api-keys
NEON_API_KEY=your-neon-api-key

# Get your Project ID from: Neon Console → Project Settings → General
NEON_PROJECT_ID=your-neon-project-id

# Optional: Parent branch ID for ephemeral branches
PARENT_BRANCH_ID=your-branch-id

# Database name (default: neondb)
DB_NAME=neondb

# Set to 'true' to delete ephemeral branches after container stops
DELETE_BRANCH=true

# Neon Local host and port (when using Docker)
NEON_LOCAL_HOST=neon-local
NEON_LOCAL_PORT=5432
